    "build:ios": "react-native bundle --entry-file='index.js' --bundle-output='./ios/SchoolBright/main.jsbundle' --dev=false --platform='ios' --assets-dest='./ios'",
    "build:ios-staging": "react-native bundle --entry-file='index.js' --bundle-output='./ios/SchoolBright/main.jsbundle' --dev=false --platform='ios' --assets-dest='./ios'",
